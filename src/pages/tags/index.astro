---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = await getCollection('posts', ({ data }) => !data.draft);

const counts = new Map();
for (const post of posts) {
  for (const tag of post.data.tags) {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
  }
}

const tags = [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'zh'));
---

<Base title="标签" description="按标签浏览全部文章。">
  <section class="hero" style="padding-bottom:20px">
    <div class="wrap">
      <p class="hero-eyebrow"><i></i> 共 {tags.length} 个主题</p>
      <h1 style="font-size:clamp(2rem,4vw,3rem)">标签</h1>
      <p class="sub">按主题翻。写得不多，但每个标签下面都是实际处理过的事。</p>
    </div>
  </section>

  <div class="wrap">
    <div class="tag-cloud">
      {tags.map(([tag, count]) => (
        <a class="chip" href={`/tags/${encodeURIComponent(tag)}/`}>
          #{tag}
          <em>{count}</em>
        </a>
      ))}
    </div>
  </div>
</Base>
