---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmtDate = (d) =>
  d.toISOString().slice(0, 10).split('-').join('.');

const readingTime = (body = '') => Math.max(1, Math.round(body.length / 400));
---

<Base
  title="致恒的跨境手记 — 跨境电商、独立站与出海服务"
  description="关于跨境电商、独立站建站与出海服务的一手观察。写得慢，但都是自己踩过的坑。"
>
  <section class="hero">
    <p class="eyebrow">Personal Notes</p>
    <h1>致恒的跨境手记</h1>
    <p class="lede">关于跨境电商、独立站建站与出海服务的一手观察。写得慢，但都是自己踩过的坑。</p>
  </section>

  <div class="list-head">
    <h2>全部文章</h2>
    <span class="count">共 {posts.length} 篇</span>
  </div>

  <ul class="post-list">
    {posts.map((post) => (
      <li class="post-item">
        <a href={`/posts/${post.id}/`}>
          <div class="post-meta">
            <time datetime={post.data.date.toISOString()}>{fmtDate(post.data.date)}</time>
            <span class="dot" />
            <span>{readingTime(post.body)} 分钟</span>
          </div>
          <h3>{post.data.title}</h3>
          <p>{post.data.description}</p>
          <div class="tags">
            {post.data.tags.map((tag) => (
              <span class="tag">#{tag}</span>
            ))}
          </div>
        </a>
      </li>
    ))}
  </ul>
</Base>
