---
import Cover from './Cover.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
  index?: number;
}

const { post, index = 0 } = Astro.props;
const minutes = Math.max(1, Math.round((post.body ?? '').length / 400));
const tags = post.data.tags ?? [];
---

<a class="post-card" href={`/posts/${post.id}/`}>
  <Cover title={post.data.title} index={index} />
  <div class="card-body">
    {tags.length > 0 && (
      <div class="card-tags">
        <span class="chip chip-accent">{tags[0]}</span>
        {tags.slice(1, 3).map((tag) => <span class="chip">{tag}</span>)}
      </div>
    )}
    <h3>{post.data.title}</h3>
    <div class="card-meta">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <circle cx="12" cy="12" r="9" />
        <path d="M12 7v5l3 2" />
      </svg>
      <span>{minutes} 分钟</span>
    </div>
  </div>
</a>
